 <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></StackPanel.Resources>
 <Button x:Name="ToggleHistory" Content="閉じる" MinWidth="90" ToolTip="左の一覧を閉じる"/>
 <Button x:Name="ShowLikes" Content="スキ"/>
 <Button x:Name="ShowPdfs" Content="PDF"/>
 <Button x:Name="ShowImages" Content="画像"/>
