    </Style.Triggers>
   </Style>
  </DockPanel.Resources>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button x:Name="CloseSettings" Content="← 戻る"/><TextBlock Text="設定" FontSize="24" Margin="16,4"/></StackPanel>
  <TextBlock x:Name="SettingsStatus" DockPanel.Dock="Bottom" Margin="16" TextWrapping="Wrap" Foreground="#245E50"/>
