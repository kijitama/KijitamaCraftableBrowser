 <DockPanel x:Name="SettingsScreen" Visibility="Collapsed" Margin="16" Background="White">
  <DockPanel.Resources>
   <Style TargetType="GroupBox">
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter Property="Background" Value="#F0F7FA"/>
