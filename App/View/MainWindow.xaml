<WrapPanel><Button x:Name="SaveAiChatLink" Content="追加"/><Button x:Name="CancelAiChatEdit" Content="キャンセル" Visibility="Collapsed"/></WrapPanel>
<TextBlock x:Name="AiChatEmpty" Text="まだリンクが登録されていません。" Foreground="#596675" Margin="3,8"/>
<TextBlock x:Name="QuickLinkCount" Foreground="#596675" Margin="3,4"/><ScrollViewer x:Name="QuickLinkListScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="AiChatLinks"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#D6DEE3" BorderThickness="1" CornerRadius="5" Padding="4" Margin="3,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding name}" ToolTip="{Binding name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="3"/><TextBlock Grid.Column="1" Text="{Binding url}" TextTrimming="CharacterEllipsis" ToolTip="{Binding url}" Foreground="#596675" VerticalAlignment="Center" Margin="6,3"/><StackPanel Grid.Column="2" Orientation="Horizontal"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="28"/></Style></StackPanel.Resources><Button Content="編集" CommandParameter="edit"/><Button Content="削除" CommandParameter="delete"/><Button Content="↑" CommandParameter="up" ToolTip="上へ移動" AutomationProperties.Name="上へ移動"/><Button Content="↓" CommandParameter="down" ToolTip="下へ移動" AutomationProperties.Name="下へ移動"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<TextBlock Text="リンクは全プロフィール共通です。現在のプロフィールの新しいタブで開きます。" TextWrapping="Wrap" Margin="3,8"/>
</StackPanel></GroupBox>
<GroupBox Header="ホームURL" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="起動時に表示するURL(homeボタンに設定されます)" Margin="3,4"/><TextBox x:Name="HomeUrl" ToolTip="https://から始まるURL"/><Button x:Name="SaveHomeUrl" Content="ホームURLを保存" HorizontalAlignment="Left"/></StackPanel></GroupBox>
<GroupBox Header="プロフィール管理" Padding="16" Margin="0,0,0,24">
    <StackPanel>
     <TextBlock Text="新しいプロフィールを追加" Margin="3,4"/><DockPanel Margin="0,0,0,12"><Button x:Name="AddProfile" Content="追加" DockPanel.Dock="Right"/><TextBox x:Name="ProfileName" ToolTip="新規プロフィール名" AutomationProperties.Name="新規プロフィール名"/></DockPanel><TextBlock Text="変更するプロフィール" Margin="3,4"/>
     <ComboBox x:Name="SettingsProfiles" DisplayMemberPath="name" Margin="3,6" Padding="6"/>
     <TextBlock Text="プロフィール名" Margin="3,8,3,0"/>
     <TextBox x:Name="SettingsProfileName"/>
     <StackPanel Orientation="Horizontal"><Button x:Name="RenameProfile" Content="名前を保存"/><Button x:Name="SettingsDeleteProfile" Content="プロフィールを削除"/></StackPanel>
     <TextBlock Text="削除すると一覧から除外します。ログインデータと履歴ファイルは復旧用に残ります。デフォルトのプロフィールは削除できません。" TextWrapping="Wrap" Margin="3,8"/>
    </StackPanel>
   </GroupBox>
<GroupBox Header="ダウンロード保存先" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="ウェブサイトから取得したファイルの保存先です。" TextWrapping="Wrap"/><DockPanel><Button x:Name="BrowseDownloadDirectory" Content="参照…" DockPanel.Dock="Right"/><TextBox x:Name="DownloadDirectory"/></DockPanel><WrapPanel><Button x:Name="SaveDownloadDirectory" Content="保存"/><Button x:Name="ResetDownloadDirectory" Content="Windowsのダウンロードフォルダーに戻す"/></WrapPanel><TextBlock Text="「名前を付けて保存」では毎回保存先を選べます。" TextWrapping="Wrap"/></StackPanel></GroupBox>
<GroupBox Header="PDF出力先設定" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="保存先フォルダー（相対パスはアプリ直下を基準にします）" Margin="3,4"/><DockPanel><Button x:Name="BrowsePdfDirectory" Content="フォルダーを選択…" DockPanel.Dock="Right"/><TextBox x:Name="PdfDirectory"/></DockPanel><Button x:Name="SavePdfDirectory" Content="保存先を設定" HorizontalAlignment="Left"/><TextBlock Text="初期値：data/pdf" Margin="3,4"/></StackPanel></GroupBox>
<GroupBox Header="撮影画像の保存先設定" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="保存先フォルダー（相対パスはアプリ直下を基準にします）" Margin="3,4"/><DockPanel><Button x:Name="BrowseImageDirectory" Content="フォルダーを選択…" DockPanel.Dock="Right"/><TextBox x:Name="ImageDirectory"/></DockPanel><Button x:Name="SaveImageDirectory" Content="保存先を設定" HorizontalAlignment="Left"/><Separator Margin="3,12"/><TextBlock Text="保存画像形式" Margin="3,4"/><WrapPanel><RadioButton x:Name="ImageFormatWebp" GroupName="CaptureFormat" Content="WebP" Margin="6,6,16,6"/><RadioButton x:Name="ImageFormatPng" GroupName="CaptureFormat" Content="PNG" Margin="6,6,16,6"/><RadioButton x:Name="ImageFormatJpg" GroupName="CaptureFormat" Content="JPG" Margin="6,6,16,6"/></WrapPanel><CheckBox x:Name="SplitLargeImages" Content="大きいサイズは分割して保存する" Margin="6,8"/><TextBlock Text="分割ONの場合、上限を超えるページを連番付きの画像に保存します。" TextWrapping="Wrap" Margin="3,4"/><TextBlock Text="撮影した画像の保存先です。変更後は左窓の画像一覧も新しい保存先を表示します。既存の画像は移動しません。" TextWrapping="Wrap" Margin="3,4"/></StackPanel></GroupBox>
</StackPanel>
<StackPanel x:Name="SettingsAiColumn" Grid.Row="1" Grid.Column="0">
<GroupBox Header="Codex CLI 接続" Padding="16" Margin="0,0,0,24"><StackPanel><StackPanel Orientation="Horizontal" Margin="3,4,3,10"><RadioButton x:Name="CodexEnabled" GroupName="CodexUsage" Content="有効" Margin="0,0,20,0"/><RadioButton x:Name="CodexDisabled" GroupName="CodexUsage" Content="無効"/></StackPanel><TextBlock Text="切り替えは自動保存されます。無効の場合、AI機能は動作しません。設定したパスは保持します。" TextWrapping="Wrap" Margin="3,4"/>
    <TextBlock Text="Codexのパス（CLIのcodex.exe）" Margin="3,4"/>
    <DockPanel><Button x:Name="DetectCodex" Content="自動検出" DockPanel.Dock="Right"/><Button x:Name="BrowseCodex" Content="参照…" DockPanel.Dock="Right"/><TextBox x:Name="CodexPath"/></DockPanel>
    <TextBlock Text="ログイン済みのCodex CLIを使用します。デスクトップ版の起動用exeとは異なります。" TextWrapping="Wrap" Margin="3,6"/>
<TextBlock Text="AI機能の利用により、ご契約のプランや利用方法によってはクレジットを消費したり、追加料金が発生したりする場合があります。ご利用前に、契約内容・利用上限・料金をご確認ください。" TextWrapping="Wrap" Margin="3,6"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="SaveCodex" Content="パスを保存"/><Button x:Name="CheckCodex" Content="接続確認"/></StackPanel>
    <ProgressBar x:Name="CodexProgress" Height="8" Margin="3,8" Foreground="Green" IsIndeterminate="True" Visibility="Collapsed"/>
    <TextBlock x:Name="CodexStatus" Text="未確認（CLIの起動とログイン状態を確認します）" TextWrapping="Wrap" Margin="3,4"/>
    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,12,3,4">
     <StackPanel>
      <TextBlock Text="AI機能をご利用になる前に" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="送信する情報" FontWeight="SemiBold"/>
      <TextBlock Text="要約を実行すると、表示ページのタイトルと、設定した文字数上限までの本文をCodex CLI経由でAIへ送信します。ページURLは送信しませんが、本文やタイトルに含まれる個人情報・機密情報がすべて自動で除去されるわけではありません。送信してよい内容か確認し、送信したくないサイトは「AIへの送信制限」に登録してください。" TextWrapping="Wrap" Margin="0,4,0,10"/>
      <TextBlock Text="回答の確認" FontWeight="SemiBold"/>
      <TextBlock Text="AIの回答には誤りや偏りが含まれる場合があります。ページ内に書かれた不正な指示によって、回答が誘導される可能性もあります。要約は安全性や正確性を保証するものではありません。重要な判断では、公式情報などで裏付けを確認してください。" TextWrapping="Wrap" Margin="0,4,0,10"/>
      <TextBlock Text="ソフトウェアの更新" FontWeight="SemiBold"/>
      <TextBlock Text="Windows、PowerShell、Codex CLI、WebView2 Runtimeを更新し、アプリも提供される更新版をご利用ください。関連ソフトや部品がすべてこのアプリから自動更新されるわけではありません。" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel></GroupBox>
<GroupBox Header="AIへの送信制限" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="AIへの送信禁止ドメイン" FontWeight="SemiBold" Margin="3,4"/><TextBlock Text="1行に1ドメイン（例：example.com、次の行にwww.example.com）。http://・ftp://・file:/などのスキーム、パス、ワイルドカードは入力しないでください。空欄なら禁止はありません。" TextWrapping="Wrap" Margin="3,4"/><TextBox x:Name="AiBlockedDomains" AcceptsReturn="True" TextWrapping="NoWrap" Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="AIへの送信禁止ドメイン"/><CheckBox x:Name="AiBlockSubdomains" Content="サブドメインも除外する" Margin="3,8"/><TextBlock Text="ON：登録ドメインと配下の全階層を拒否。OFF：登録した名前だけを完全一致で拒否。チェック状態も「禁止ドメインを保存」で保存します。" TextWrapping="Wrap" Margin="3,4"/><Button x:Name="SaveAiBlockedDomains" Content="禁止ドメインを保存" HorizontalAlignment="Left"/><TextBlock Text="禁止サイトのURL・タイトル・本文は送信せず、要約を拒否します。閲覧自体は制限しません。許可サイトでもページURLはAIへ送信しません。" TextWrapping="Wrap" Margin="3,4"/>
   </StackPanel></GroupBox>
<GroupBox Header="AIに渡す本文" Padding="16" Margin="0,0,0,24"><StackPanel>
<TextBlock Text="AIに渡すページ本文の文字数上限" FontWeight="SemiBold" Margin="3,4"/>
<Grid Margin="3,6"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="文字数上限" VerticalAlignment="Center"/><TextBox x:Name="SummaryCharacterLimit" Grid.Column="1" AutomationProperties.Name="要約の本文文字数上限"/><TextBlock Grid.Column="2" Text="文字" VerticalAlignment="Center" Margin="6"/>
</Grid>
<TextBlock x:Name="AiCharacterLimitHelp" TextWrapping="Wrap" Margin="3,4"/>
<TextBlock Text="ページから読み取る本文の上限です。増やすと処理時間や利用量が増える場合があります。保存後、次の要約から反映されます。" TextWrapping="Wrap" Margin="3,4"/>
<Button x:Name="SaveAiCharacterLimits" Content="文字数上限を保存" HorizontalAlignment="Left"/></StackPanel></GroupBox>
<GroupBox Header="❤スキ" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="FavoriteLimitHelp"/><TextBox x:Name="FavoriteLimit" Width="120" HorizontalAlignment="Left"/><Button x:Name="SaveFavoriteLimit" Content="上限を保存" HorizontalAlignment="Left"/><TextBlock Text="既存の登録は削除しません。上限を超えている間は追加できません。" TextWrapping="Wrap"/></StackPanel></GroupBox>
<GroupBox Header="ブラウザの終了" Padding="16" Margin="0,0,0,24"><StackPanel><CheckBox x:Name="SkipExitConfirmation" Content="ブラウザ終了時確認を表示しない" Margin="3,6"/><TextBlock Text="チェックすると、終了確認を表示せずにブラウザを終了します。" TextWrapping="Wrap" Margin="3,4"/></StackPanel></GroupBox>
<GroupBox Header="アプリの更新" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="CurrentAppVersion" Margin="3,4"/><TextBlock Text="起動するたびに公式の更新情報を確認します。応答が遅い場合は確認をスキップし、通常どおり利用できます。更新版のインストールは自動では行いません。閲覧履歴・ページ内容・プロフィール情報は送信しません。" TextWrapping="Wrap" Margin="3,4"/><WrapPanel><Button x:Name="CheckAppUpdates" Content="更新チェック"/><Button x:Name="DownloadLatest" Content="最新版ダウンロード" IsEnabled="False"/><Button x:Name="OpenUpdatePage" Content="公式配布ページを開く" Visibility="Collapsed"/></WrapPanel><ProgressBar x:Name="UpdateCheckProgress" Height="5" Margin="3,6" IsIndeterminate="False" Visibility="Collapsed" Foreground="#268C91"/><TextBlock x:Name="UpdateCheckStatus" TextWrapping="Wrap" Margin="3,6"/><TextBlock x:Name="LatestDownloadStatus" Text="更新情報を確認後、配布ZIPをダウンロードできます。" TextWrapping="Wrap" Margin="3,4" Foreground="#596675"/></StackPanel></GroupBox>
<GroupBox Header="閲覧履歴" Padding="16" Margin="0,0,0,24"><StackPanel>
    <TextBlock Text="全プロフィールの閲覧履歴を初期化します。削除済みプロフィールの履歴も対象です。ログイン状態は保持されます。" TextWrapping="Wrap" Margin="3,6"/>
    <Button x:Name="ClearHistory" Content="すべての閲覧履歴を消去" HorizontalAlignment="Left"/>
   </StackPanel></GroupBox>
<GroupBox x:Name="ResetSettingsGroup" Visibility="Collapsed" Header="アプリを初期化" Padding="16" Margin="0,0,0,24"><StackPanel>
<TextBlock Text="プロフィール・ログイン情報・履歴・スキ・AIデータを削除し、設定を初期値に戻して終了します。" TextWrapping="Wrap"/>
<RadioButton x:Name="ResetKeepFiles" GroupName="ResetMode" Content="PDF・画像を残して初期化" IsChecked="True" Margin="3,12,3,6"/>
<RadioButton x:Name="ResetComplete" GroupName="ResetMode" Content="すべてのデータを削除" Margin="3,6"/>
<RadioButton x:Name="ResetPristine" Foreground="Firebrick" GroupName="ResetMode" Content="完全初期化（アプリ初回起動前の状態に戻す）" Margin="3,6"/>
<TextBlock Text="「すべてのデータを削除」は保存ファイル・ログ・検証データまで削除します。「完全初期化」は取得済み部品と過去の配布物も削除し、次回は初回セットアップから開始します。配布対象外の手動追加ファイルがあれば、削除前に退避を案内します。アプリ本体・アクセス権・PCのCodexログインは保持します。標準外に設定したPDF・画像の保存先は削除せず、保存先設定だけを初期値に戻します。アプリ外のコピーも残ります。" TextWrapping="Wrap" Margin="3,6"/>
<Button x:Name="FactoryReset" Content="選択した方法で初期化…" HorizontalAlignment="Left"/>
</StackPanel></GroupBox>
</StackPanel>
</Grid></ScrollViewer>
 </DockPanel><DockPanel x:Name="LicenseScreen" Visibility="Collapsed" Margin="20"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button x:Name="CloseLicense" Content="← 戻る"/><TextBlock Text="ライセンス" FontSize="24" Margin="16,4"/></StackPanel><TextBox x:Name="LicenseText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="16"/></DockPanel></Grid></Window>





























































