    <TextBox x:Name="DownloadSearch" DockPanel.Dock="Top" ToolTip="ファイル名で検索"/>
    
    <Grid DockPanel.Dock="Top" Margin="0,3"><Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="2,5"/><Setter Property="Margin" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/></Style></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Button x:Name="DownloadSortNew" Content="新しい順" ToolTip="日付の新しい順"/><Button x:Name="DownloadSortOld" Grid.Column="1" Content="古い順" ToolTip="日付の古い順"/><Button x:Name="RefreshDownloads" Grid.Column="2" Content="一覧を更新"/></Grid><TextBlock x:Name="DownloadListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,6"/>
    <ListBox x:Name="DownloadFiles" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Left" Margin="0,2" Padding="4" ToolTip="{Binding path, StringFormat=エクスプローラーで表示：{0}}"><StackPanel><TextBlock Text="{Binding name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding modified}" FontSize="11" Foreground="#596675"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel><DockPanel x:Name="FavoritesPanel" Visibility="Collapsed" Margin="0,4,8,0">
    <TextBlock DockPanel.Dock="Top" Text="❤スキ" FontSize="20" FontWeight="SemiBold" Margin="3,5"/>
    <TextBox x:Name="FavoriteSearch" DockPanel.Dock="Top" ToolTip="タイトル・URLを検索"/>
    <Grid DockPanel.Dock="Top" Margin="0,3"><Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="2,5"/><Setter Property="Margin" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/></Style></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Button x:Name="FavoriteSortNew" Content="新しい順" ToolTip="日付の新しい順"/><Button x:Name="FavoriteSortOld" Grid.Column="1" Content="古い順" ToolTip="日付の古い順"/><Button x:Name="RefreshFavorites" Grid.Column="2" Content="一覧を更新"/></Grid><TextBlock x:Name="FavoriteCount" DockPanel.Dock="Top" Margin="3,4"/>
    <ListBox x:Name="Favorites" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
