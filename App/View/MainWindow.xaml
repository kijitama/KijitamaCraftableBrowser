<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStartupLocation="CenterScreen" Background="#F5F7F8" MinWidth="900" MinHeight="600">
 <Window.Resources>
  <Style x:Key="ProfileSelectorStyle" TargetType="ComboBox">
   <Setter Property="Height" Value="36"/><Setter Property="Width" Value="220"/>
   <Setter Property="Foreground" Value="#243746"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="ItemBorder" CornerRadius="4" Margin="3,1" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EAF0F4"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E2F2EC"/><Setter Property="Foreground" Value="#176B54"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="SelectorToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="SelectorBorder" CornerRadius="6" Background="White" BorderBrush="#D6DEE3" BorderThickness="1">
        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#647787" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
       </Border>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#8FA5B5"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#17866A"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <TextBlock x:Name="SelectedProfileName" Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding SelectedItem.name, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0" Padding="2,4" Background="White" BorderBrush="#D6DEE3" BorderThickness="1" CornerRadius="6"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
 <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#243746"/><Setter Property="BorderBrush" Value="#D6DEE3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel Orientation="Horizontal"><Image x:Name="Icon" Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Margin="0,0,6,0"/><ContentPresenter Content="{Binding}" VerticalAlignment="Center"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate></Setter.Value></Setter>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#EAF0F4"/><Setter TargetName="Frame" Property="BorderBrush" Value="#8FA5B5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#DCE8EE"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#17866A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6"/></Style>
 </Window.Resources>
 <Grid><DockPanel x:Name="BrowserScreen" Margin="8">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel Height="44">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenSettings" Content="設定"/><Button x:Name="OpenLicense" Content="ライセンス"/></StackPanel>
    <TextBlock Text="プロフィール切替" VerticalAlignment="Center" Margin="5"/>
    <ComboBox x:Name="Profiles" Style="{StaticResource ProfileSelectorStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" DisplayMemberPath="name" Margin="6,3,3,3" ToolTip="プロフィールを切り替えます。ログイン状態はプロフィールごとに保存されます。" AutomationProperties.Name="プロフィール切替"/>
    <Grid Margin="12,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="TabsScrollLeft" Width="28" Padding="6" VerticalAlignment="Center" ToolTip="左のタブを表示" AutomationProperties.Name="左のタブを表示" IsEnabled="False"><Button.Content><Path Data="M 8,0 L 2,6 L 8,12" Stroke="#647787" StrokeThickness="1.5"/></Button.Content><Button.ContentTemplate><DataTemplate><ContentPresenter Content="{Binding}"/></DataTemplate></Button.ContentTemplate></Button>
     <ScrollViewer x:Name="TabsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
      <StackPanel x:Name="BrowserTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
     </ScrollViewer>
     <Button x:Name="TabsScrollRight" Grid.Column="2" Width="28" Padding="6" VerticalAlignment="Center" ToolTip="右のタブを表示" AutomationProperties.Name="右のタブを表示" IsEnabled="False"><Button.Content><Path Data="M 2,0 L 8,6 L 2,12" Stroke="#647787" StrokeThickness="1.5"/></Button.Content><Button.ContentTemplate><DataTemplate><ContentPresenter Content="{Binding}"/></DataTemplate></Button.ContentTemplate></Button>
     <Button x:Name="NewTab" Grid.Column="3" Content="＋" ToolTip="新しいタブ" AutomationProperties.Name="新しいタブ" Width="36" VerticalAlignment="Center"/>
    </Grid>
   </DockPanel>
   <Grid Height="44">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Back" Content="←" ToolTip="戻る"/><Button x:Name="Forward" Content="→" ToolTip="進む"/><Button x:Name="Reload" Content="再読込"/><Button x:Name="Home" Content="home"/></StackPanel>
    <DockPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center"><Button x:Name="Go" Content="移動" DockPanel.Dock="Right"/><ComboBox x:Name="Address" Height="34" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" TextSearch.TextPath="url" VerticalContentAlignment="Center" MaxDropDownHeight="300"><ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding url}" Foreground="#647787" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="1" Height="24" Background="#D6DEE3" Margin="4,0"/>
     <StackPanel x:Name="HeaderSaveActions" Orientation="Horizontal"><Button x:Name="AddFavorite" Content="スキ" ToolTip="アプリ内のスキリストに保存"/><Button x:Name="SavePdf" Content="PDF保存"/><Button x:Name="CaptureImage" Content="撮影" ToolTip="読み込み済みのページ全体を画像保存"/></StackPanel>
     <Button x:Name="CompactSave" Content="保存 ▼" Visibility="Collapsed"><Button.ContextMenu><ContextMenu><MenuItem x:Name="CompactFavorite" Header="スキに登録"/><MenuItem x:Name="CompactPdf" Header="PDF保存"/><MenuItem x:Name="CompactCapture" Header="撮影"/></ContextMenu></Button.ContextMenu></Button>
     <Border Width="1" Height="24" Background="#D6DEE3" Margin="4,0"/>
     <Button x:Name="AiChatMenu" Content="QUICK ▾" ToolTip="登録したサイトを新しいタブで開く" MaxWidth="180"/><Button x:Name="AiSupport" Content="AI支援" ToolTip="表示ページの要約" ToolTipService.ShowOnDisabled="True"/>
    </StackPanel>
   </Grid>
  </StackPanel>
  <Grid x:Name="BrowserFooter" DockPanel.Dock="Bottom" Height="32">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <Border x:Name="ActionToast" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,8,0" Padding="10,3" CornerRadius="6" Background="#E6F2F7" BorderBrush="#7F9EAE" BorderThickness="1" Opacity="0">
    <TextBlock x:Name="ActionToastText" TextTrimming="CharacterEllipsis" Foreground="#183746"/>
   </Border>
   <StackPanel x:Name="FooterUpdateProgress" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Width="180" Visibility="Collapsed"><TextBlock Text="更新情報を確認しています…" FontSize="11" Margin="0,0,0,2"/><ProgressBar x:Name="FooterUpdateBar" Height="4" IsIndeterminate="False" Foreground="#268C91"/></StackPanel>
   <TextBlock x:Name="FooterAppVersion" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#596675" Margin="8,0,6,0"/>
  </Grid>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryColumn" Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="SideColumn" Width="310"/></Grid.ColumnDefinitions>
   <Grid x:Name="LeftPanel"><DockPanel x:Name="HistoryPanel" Margin="0,4,8,0">
    <TextBlock DockPanel.Dock="Top" Text="閲覧履歴" FontSize="20" FontWeight="SemiBold" Margin="4,5"/>
    <TextBox x:Name="HistorySearch" DockPanel.Dock="Top" ToolTip="タイトル・URLを検索（空欄で全件表示）" AutomationProperties.Name="閲覧履歴を検索"/>
    <Grid DockPanel.Dock="Top" Margin="0,3"><Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="2,5"/><Setter Property="Margin" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/></Style></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Button x:Name="HistorySortNew" Content="新しい順" ToolTip="日付の新しい順"/><Button x:Name="HistorySortOld" Grid.Column="1" Content="古い順" ToolTip="日付の古い順"/><Button x:Name="RefreshHistory" Grid.Column="2" Content="一覧を更新"/></Grid><TextBlock x:Name="HistorySearchStatus" DockPanel.Dock="Top" Margin="4,2,4,6" Foreground="#596675"/>
    <ListBox x:Name="History" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ContextMenu><ContextMenu><MenuItem Header="削除"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate>
      <Button HorizontalContentAlignment="Left" Padding="4" Margin="0,2" ToolTip="{Binding url}">
       <StackPanel><TextBlock Text="{Binding title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding url}" TextWrapping="Wrap" FontSize="11" Foreground="#596675"/></StackPanel>
      </Button>
     </DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
      <DockPanel x:Name="PdfListPanel" Visibility="Collapsed" Margin="0,4,8,0">
    <TextBlock DockPanel.Dock="Top" Text="保存したPDF" FontSize="20" FontWeight="SemiBold" Margin="4,5"/>
    <TextBox x:Name="PdfSearch" DockPanel.Dock="Top" ToolTip="ファイル名で検索"/>
    
    <Grid DockPanel.Dock="Top" Margin="0,3"><Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="2,5"/><Setter Property="Margin" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/></Style></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Button x:Name="PdfSortNew" Content="新しい順" ToolTip="日付の新しい順"/><Button x:Name="PdfSortOld" Grid.Column="1" Content="古い順" ToolTip="日付の古い順"/><Button x:Name="RefreshPdfs" Grid.Column="2" Content="一覧を更新"/></Grid><TextBlock x:Name="PdfListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,6"/>
    <ListBox x:Name="PdfFiles" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ContextMenu><ContextMenu><MenuItem Header="削除"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Left" Margin="0,2" Padding="4" ToolTip="{Binding path}"><StackPanel><TextBlock Text="{Binding name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding modified}" FontSize="11" Foreground="#596675"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel><DockPanel x:Name="ImageListPanel" Visibility="Collapsed" Margin="0,4,8,0">
    <TextBlock DockPanel.Dock="Top" Text="保存した画像" FontSize="20" FontWeight="SemiBold" Margin="4,5"/>
    <TextBox x:Name="ImageSearch" DockPanel.Dock="Top" ToolTip="ファイル名で検索"/>
    
    <Grid DockPanel.Dock="Top" Margin="0,3"><Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="2,5"/><Setter Property="Margin" Value="1"/><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="30"/></Style></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Button x:Name="ImageSortNew" Content="新しい順" ToolTip="日付の新しい順"/><Button x:Name="ImageSortOld" Grid.Column="1" Content="古い順" ToolTip="日付の古い順"/><Button x:Name="RefreshImages" Grid.Column="2" Content="一覧を更新"/></Grid><TextBlock x:Name="ImageListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,6"/>
    <ListBox x:Name="ImageFiles" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ContextMenu><ContextMenu><MenuItem Header="削除"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Left" Margin="0,2" Padding="4" ToolTip="{Binding path}"><StackPanel><TextBlock Text="{Binding name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding modified}" FontSize="11" Foreground="#596675"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>   <DockPanel x:Name="DownloadListPanel" Visibility="Collapsed" Margin="0,4,8,0">
