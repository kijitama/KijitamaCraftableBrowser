     <ListBox.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Left" Margin="0,2" Padding="4" ToolTip="{Binding url}"><StackPanel><TextBlock Text="{Binding title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding url}" TextWrapping="Wrap" FontSize="11" Foreground="#596675"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
